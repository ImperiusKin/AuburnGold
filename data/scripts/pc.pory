raw `
EventScript_PC::
	lockall
	setvar VAR_0x8004, PC_LOCATION_OTHER
	special DoPCTurnOnEffect
	playse SE_PC_ON
	msgbox Text_BootUpPC, MSGBOX_DEFAULT
	goto EventScript_PCMainMenu
	end

EventScript_PCMainMenu::
	message gText_WhichPCShouldBeAccessed
	waitmessage
	special ScriptMenu_CreatePCMultichoice
	goto EventScript_AccessPC
	end

EventScript_AccessPC::
	switch VAR_RESULT
	case 0, EventScript_AccessPokemonStorage
	case 1, EventScript_AccessPlayersPC
	case 2, EventScript_AccessHallOfFame
	case 3, EventScript_TurnOffPC
	case MULTI_B_PRESSED, EventScript_TurnOffPC
	end

EventScript_AccessPlayersPC::
	playse SE_PC_LOGIN
	msgbox gText_AccessedPlayersPC, MSGBOX_DEFAULT
	special PlayerPC
	goto EventScript_PCMainMenu
	end

EventScript_AccessPokemonStorage::
	playse SE_PC_LOGIN
	call_if_unset FLAG_SYS_PC_LANETTE, EventScript_AccessSomeonesPC
	call_if_set FLAG_SYS_PC_LANETTE, EventScript_AccessLanettesPC
	msgbox gText_StorageSystemOpened, MSGBOX_DEFAULT
	special ShowPokemonStorageSystemPC
	goto EventScript_PCMainMenu
	end

EventScript_AccessSomeonesPC::
	msgbox gText_AccessedSomeonesPC, MSGBOX_DEFAULT
	return

EventScript_AccessLanettesPC::
#if IS_FRLG
	msgbox gText_AccessedBillsPC, MSGBOX_DEFAULT
#else
	msgbox gText_AccessedLanettesPC, MSGBOX_DEFAULT
#endif
	return

EventScript_TurnOffPC::
	setvar VAR_0x8004, PC_LOCATION_OTHER
	playse SE_PC_OFF
	special DoPCTurnOffEffect
	releaseall
	end

EventScript_AccessHallOfFame::
	goto_if_unset FLAG_SYS_GAME_CLEAR, EventScript_TurnOffPC
	playse SE_PC_LOGIN
	special AccessHallOfFamePC
	goto EventScript_AccessPC
	end

EventScript_AccessPokemonBoxLink::
	playse SE_PC_LOGIN
	msgbox gText_StorageSystemOpened, MSGBOX_DEFAULT
	special ShowPokemonStorageSystemPC
	goto EventScript_TurnOffPC
	end
	
EventScript_PC_FromStartMenu::
	lockall
	setvar VAR_0x8004, PC_LOCATION_OTHER
	playse SE_PC_ON
	msgbox gText_StorageSystemOpened, MSGBOX_DEFAULT
	special ShowPokemonStorageSystemPC
	goto EventScript_TurnOffPC
	end
`

script EventScript_AccessTimeChanger{
	playse(SE_PC_LOGIN)
	msgbox(format("What time do you want to set?"), MSGBOX_DEFAULT)
	multichoicedefault (21, 0, MULTI_TIME_CHANGER, 0, FALSE)
	switch(var(VAR_RESULT)){
		case TIME_MORNING:
			if(flag(FLAG_FORCE_TIME_OF_DAY) && var(VAR_FORCED_TIME_OF_DAY) == TIME_MORNING){
				msgbox(format("The time is already set to Morning!"), MSGBOX_DEFAULT)
			}
			else{
				msgbox(format("The time has been changed to Morning!"), MSGBOX_DEFAULT)
				setflag(FLAG_FORCE_TIME_OF_DAY)
				setvar(VAR_FORCED_TIME_OF_DAY, TIME_MORNING)
				special(UseTimeChanger)
			}
		break
		case TIME_DAY:
			if(flag(FLAG_FORCE_TIME_OF_DAY) && var(VAR_FORCED_TIME_OF_DAY) == TIME_DAY){
				msgbox(format("The time is already set to Day!"), MSGBOX_DEFAULT)
			}
			else{
				msgbox(format("The time has been changed Day!"), MSGBOX_DEFAULT)
				setflag(FLAG_FORCE_TIME_OF_DAY)
				setvar(VAR_FORCED_TIME_OF_DAY, TIME_DAY)
				special(UseTimeChanger)
			}
		break
		case TIME_EVENING:
			if(flag(FLAG_FORCE_TIME_OF_DAY) && var(VAR_FORCED_TIME_OF_DAY) == TIME_EVENING){
				msgbox(format("The time is already set to Evening!"), MSGBOX_DEFAULT)
			}
			else{
				msgbox(format("The time has been changed to Evening!"), MSGBOX_DEFAULT)
				setflag(FLAG_FORCE_TIME_OF_DAY)
				setvar(VAR_FORCED_TIME_OF_DAY, TIME_EVENING)
				special(UseTimeChanger)
			}
		break
		case TIME_NIGHT:
			if(flag(FLAG_FORCE_TIME_OF_DAY) && var(VAR_FORCED_TIME_OF_DAY) == TIME_NIGHT){
				msgbox(format("The time is already set to Night!"), MSGBOX_DEFAULT)
			}
			else{
				msgbox(format("The time has been changed Night!"), MSGBOX_DEFAULT)
				setflag(FLAG_FORCE_TIME_OF_DAY)
				setvar(VAR_FORCED_TIME_OF_DAY, TIME_NIGHT)
				special(UseTimeChanger)
			}
		break
		case TIMES_OF_DAY_COUNT:
			if(!flag(FLAG_FORCE_TIME_OF_DAY)){
				msgbox(format("The time is already set to real time!"), MSGBOX_DEFAULT)
			}
			else{
				msgbox(format("The time has been set to to follow the real time!"), MSGBOX_DEFAULT)
				clearflag(FLAG_FORCE_TIME_OF_DAY)
				setvar(VAR_FORCED_TIME_OF_DAY, TIMES_OF_DAY_COUNT)
				special(UseTimeChanger)
			}
		break
		case MULTI_B_PRESSED:
			msgbox(format("The Time Changer System was closed!"), MSGBOX_DEFAULT)
		break
	}
	releaseall
	end
}

script EventScript_AfterWhiteOutHeal{
	lockall
	msgbox(gText_FirstShouldRestoreMonsHealth)
	call(EventScript_PkmnCenterNurse_TakeAndHealPkmn)
	if(flag(FLAG_DEFEATED_RUSTBORO_GYM)){
		msgbox("Your POKéMON have been healed\n"
			   "to perfect health.\p"
			   "We hope you excel!$")
	}
	else{
		msgbox("Your POKéMON have been healed\n"
			   "to perfect health.\p"
			   "If your POKéMON's energy, HP,\n"
			   "is down, please come see us.\p"
			   "If you're planning to go far in the\n"
			   "field, you should buy some POTIONS\l"
			   "at the POKéMON MART.\p"
			   "We hope you excel!$")
	}
	applymovement(VAR_LAST_TALKED, Movement_PkmnCenterNurse_Bow)
	waitmovement(0)
	fadedefaultbgm
	if(flag(FLAG_SYS_NUZLOCKE_MODE)){
		message(format("You lost this Nuzlocke run, Nuzlocke Mode has been disabled, you can continue this save file as if it was a normal save or start a new save, the game will now save!"))
		clearflag(FLAG_SYS_NUZLOCKE_MODE)
		special(HealPlayerParty)
		waitmessage
		forcesave
	}
	releaseall
	end
}

const HEX_ORB_POISON = 0
const HEX_ORB_PARALYSIS = 1
const HEX_ORB_BURN = 2
const HEX_ORB_FROSTBITE = 3
const HEX_ORB_CANCEL = 4

//const HEX_ORB_SLEEP = 2
//const HEX_ORB_FREEZE = 4

script EventScript_HexOrb_Single{
	msgbox(format("Choose what Pokémon you want to inflict with an status!"), MSGBOX_DEFAULT)
	special(ChoosePartyMon)
	goto_if_ge(VAR_0x8004, PARTY_SIZE, EventScript_HexOrb_Single_Cancel)
	specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
	goto_if_eq(VAR_RESULT, SPECIES_EGG, EventScript_HexOrb_Single_Egg)
	dynmultipush(format("Poison"),    HEX_ORB_POISON)
	dynmultipush(format("Paralysis"), HEX_ORB_PARALYSIS)
	//dynmultipush(format("Sleep"),   HEX_ORB_SLEEP)
	dynmultipush(format("Burn"),      HEX_ORB_BURN)
	//dynmultipush(format("Freeze"),  HEX_ORB_FREEZE)
	dynmultipush(format("Frostbite"), HEX_ORB_FROSTBITE)
	dynmultipush(format("Close"),     HEX_ORB_CANCEL)
	bufferpartymonnick(STR_VAR_1, VAR_0x8004)
	msgbox(format("What status do you want {STR_VAR_1} to be inflicted with."), MSGBOX_DEFAULT)
	dynmultistack(0, 0, FALSE, 5, FALSE, 0, NULL)
	switch(var(VAR_RESULT)){
		case HEX_ORB_POISON:
			setstatus1(STATUS1_POISON, VAR_0x8004)
			if(var(VAR_0x8004) == SET_STATUS_POSSIBLE){
				msgbox(format("{STR_VAR_1} was inflicted with Poison!"), MSGBOX_DEFAULT)
			}
			elif(var(VAR_0x8004) == SET_STATUS_NOT_POSSIBLE_ABILITY){
				msgbox(format("{STR_VAR_1} cannot be Poisoned due to its ability!"), MSGBOX_DEFAULT)
			}
			else{
				msgbox(format("{STR_VAR_1} cannot be Poisoned due to its typing!"), MSGBOX_DEFAULT)
			}
		break
		case HEX_ORB_PARALYSIS:
			setstatus1(STATUS1_PARALYSIS, VAR_0x8004)
			if(var(VAR_0x8004) == SET_STATUS_POSSIBLE){
				msgbox(format("{STR_VAR_1} was inflicted with Paralysis!"), MSGBOX_DEFAULT)
			}
			elif(var(VAR_0x8004) == SET_STATUS_NOT_POSSIBLE_ABILITY){
				msgbox(format("{STR_VAR_1} cannot be Paralyzed due to its ability!"), MSGBOX_DEFAULT)
			}
			else{
				msgbox(format("{STR_VAR_1} cannot be Paralyzed due to its typing!"), MSGBOX_DEFAULT)
			}
		break
		//case HEX_ORB_SLEEP:
		//	setstatus1(STATUS1_SLEEP, VAR_0x8004)
		//	if(var(VAR_0x8004) == SET_STATUS_POSSIBLE){
		//		msgbox(format("{STR_VAR_1} was inflicted with Sleep!"), MSGBOX_DEFAULT)
		//	}
		//	elif(var(VAR_0x8004) == SET_STATUS_NOT_POSSIBLE_ABILITY){
		//		msgbox(format("{STR_VAR_1} cannot be Slept due to its ability!"), MSGBOX_DEFAULT)
		//	}
		//	else{
		//		msgbox(format("{STR_VAR_1} cannot be Slept due to its typing!"), MSGBOX_DEFAULT)
		//	}
		//break
		case HEX_ORB_BURN:
			setstatus1(STATUS1_BURN, VAR_0x8004)
			if(var(VAR_0x8004) == SET_STATUS_POSSIBLE){
				msgbox(format("{STR_VAR_1} was inflicted with Burn!"), MSGBOX_DEFAULT)
			}
			elif(var(VAR_0x8004) == SET_STATUS_NOT_POSSIBLE_ABILITY){
				msgbox(format("{STR_VAR_1} cannot be Burned due to its ability!"), MSGBOX_DEFAULT)
			}
			else{
				msgbox(format("{STR_VAR_1} cannot be Burned due to its typing!"), MSGBOX_DEFAULT)
			}
		break
		//case HEX_ORB_FREEZE:
		//	setstatus1(STATUS1_FREEZE, VAR_0x8004)
		//	if(var(VAR_0x8004) == SET_STATUS_POSSIBLE){
		//		msgbox(format("{STR_VAR_1} was inflicted with Freeze!"), MSGBOX_DEFAULT)
		//	}
		//	elif(var(VAR_0x8004) == SET_STATUS_NOT_POSSIBLE_ABILITY){
		//		msgbox(format("{STR_VAR_1} cannot be Frozen due to its ability!"), MSGBOX_DEFAULT)
		//	}
		//	else{
		//		msgbox(format("{STR_VAR_1} cannot be Frozen due to its typing!"), MSGBOX_DEFAULT)
		//	}
		//break
		case HEX_ORB_FROSTBITE:
			setstatus1(STATUS1_FROSTBITE, VAR_0x8004)
			if(var(VAR_0x8004) == SET_STATUS_POSSIBLE){
				msgbox(format("{STR_VAR_1} was inflicted with Frostbite!"), MSGBOX_DEFAULT)
			}
			elif(var(VAR_0x8004) == SET_STATUS_NOT_POSSIBLE_ABILITY){
				msgbox(format("{STR_VAR_1} cannot be Frostbiten due to its ability!"), MSGBOX_DEFAULT)
			}
			else{
				msgbox(format("{STR_VAR_1} cannot be Frostbiten due to its typing!"), MSGBOX_DEFAULT)
			}
		break
		case HEX_ORB_CANCEL:
		case MULTI_B_PRESSED:
			goto(EventScript_HexOrb_Single_Cancel)
		break
	}
	releaseall
	end
}

script EventScript_HexOrb_Single_Cancel{
	msgbox(format("No Pokémon was inflicted with any status!"), MSGBOX_DEFAULT)
	releaseall
	end
}

script EventScript_HexOrb_Single_Egg{
	msgbox(format("Eggs can't be inflicted with status!"), MSGBOX_DEFAULT)
	releaseall
	end
}