script NewBarkTown_EventScript_Nurse{
    if(!flag(FLAG_SYS_POKEDEX_GET)){
        lock
        faceplayer
        msgbox(format("There is something happening at the lab to the north, maybe the Professor is starting another tournament!"))
    }
    else{
        goto(Common_EventScript_PkmnCenterNurse_Updated)
    }
    release
}

mart NewBarkTown_Mart_Items {
    ITEM_POKE_BALL
    ITEM_POTION
    ITEM_ANTIDOTE
    ITEM_BURN_HEAL
    ITEM_ICE_HEAL
    ITEM_AWAKENING
    ITEM_PARALYZE_HEAL
    ITEM_REVIVE
    ITEM_REPEL
    ITEM_NONE
}

script NewBarkTown_EventScript_Shop_Clerk{
    if(!flag(FLAG_SYS_POKEDEX_GET)){
        lock
        faceplayer
        msgbox(format("I wish I could go to a Pokémon journey like those people outside Elm's lab!"))
    }
    else{
        lock
        faceplayer
        message(gText_HowMayIServeYou)
        waitmessage
        pokemart(NewBarkTown_Mart_Items)
        msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
    }
    release
    end
}

