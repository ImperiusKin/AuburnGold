//Newbark Town States
// 0 - Adventure Started, no Pokémon
// 1 - Elm's speech is finished, no starter given yet
// 2 - Player got its first Pokémon and Pokédex, can go to route 29

const VAR_WOMAN_TRIGGER = VAR_TEMP_2
//Woman Trigger State
// 0 - Trigger script not letting you go to route 29
// 1 - Player is free to go to route 29
//This variable is also used to register what tile triggered the script and adopts the script accordingly

const VAR_STARTER_SOURCE = VAR_TEMP_3
//Starter Source State
// 0 - You got the starter from the Aide
// 1 - You got the starter from Professor Elm

mapscripts NewBarkTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        switch(var(VAR_NEWBARK_TOWN_STATE)){
            case 0:
            case 1:
                call(NewBarkTown_EventScript_MoveNPCs)
            break
            default:
                setvar(VAR_WOMAN_TRIGGER, 1)
            break
        }
    }
}

script NewBarkTown_EventScript_MoveNPCs{
    //Move NPCs from the crowd if the starter selection is over
    setobjectxyperm(LOCALID_NEWBARK_TRAINER_1, 21, 13)
    setobjectmovementtype (LOCALID_NEWBARK_TRAINER_1, MOVEMENT_TYPE_FACE_RIGHT)

    setobjectxyperm(LOCALID_NEWBARK_TRAINER_2, 22, 15)
    setobjectmovementtype (LOCALID_NEWBARK_TRAINER_2, MOVEMENT_TYPE_FACE_UP)

    setobjectxyperm(LOCALID_NEWBARK_TRAINER_3, 25, 13)
    setobjectmovementtype (LOCALID_NEWBARK_TRAINER_3, MOVEMENT_TYPE_FACE_LEFT)

    setobjectxyperm(LOCALID_NEWBARK_TRAINER_4, 24, 15)
    setobjectmovementtype (LOCALID_NEWBARK_TRAINER_4, MOVEMENT_TYPE_FACE_UP)
    end
}

