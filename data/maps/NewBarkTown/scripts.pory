script NewBarkTown_EventScript_Elm_Speech{
    playbgm(MUS_RG_OAK, 0)
    msgbox(format("Prof. Elm: Er... Hello, everyone."))
    msgbox(format("Um...\p"
                  "There certainly are a lot more of you than I expected\p"
                  "...\p"
                  "Right!\p"
                  "I suppose I should start.\p"
                  "Welcome to New Bark Town!\p"
                  "As I'm sure most of you already know...\p"
                  "We've been preparing for a rather unusual event.\p"
                  "Trainers from all over have come to various approved starting locations in Johto to take part in a new tournament.\p"
                  "And when I say all over...I really do mean all over.\p"
                  "Visiting gym leaders, experienced Trainers, researchers...\p"
                  "Er...\p"
                  "Well, I don't think the researchers are competing.\p"
                  "At least, I'm not...\p"
                  "Anyway!"))

    msgbox(format("The tournament will take place across both Johto and Kanto.\p"
                  "You'll begin here in Johto.\p"
                  "Travel the region, challenge the gyms, and collect all eight badges.\p"
                  "The gyms have been given a bit of what I certainly call an unfair advantage but…I didn’t get a choice in that.\p"
                  "Oh…and you can choose to challenge the gym leaders to double battles as well for additional rewards.\p"
                  "Along the way, you'll also encounter visiting gym leaders who have prepared challenges of their own.\p"
                  "Don’t you worry though, defeating them will give you sanctioned awards to help you throughout the tournament.\p"
                  "Some of them are quite strong.\p"
                  "Actually...\p"
                  "Some of them are VERY strong.\p"
                  "Maybe I shouldn't have said that.\p"
                  "Ahem."))

    msgbox(format("Once you've collected all eight Johto Badges, you'll be permitted to challenge the Elite Four.\p"
                  "Defeat them, and you'll qualify for the next stage of the tournament.\p"
                  "The Champion’s League!\p"
                  "...\p"
                  "Although, technically, you won't be able to enter it immediately.\p"
                  "There are still the Kanto qualifications...\p"
                  "And the additional challenges...\p"
                  "And...\p"
                  "Ah. I'm getting ahead of myself.\p"
                  "You'll learn about all of that when the time comes.\p"
                  "For now, there's really only one thing you need to worry about.\p"
                  "Your first destination.\p"
                  "Once you've received your Pokémon and supplies, you'll head west from New Bark Town.\p"
                  "There are already tournament challengers waiting along the routes ahead.\p"
                  "So...\p"
                  "Er...\p"
                  "Good luck, everyone!"))

    msgbox(format("Was I supposed to say something more inspiring?\p"
                  "No?\p"
                  "Good.\p"
                  "Then I think that's everything.\p"
                  "OH! I forgot…you can come inside and talk to me or you can talk to my aides outside for your Pokémon and starting package.\p"
                  "Thanks to my fellow professors, you can choose from a lot of different Pokémon to join you for this event!"))
    return
}

script NewBarkTown_EventScript_Elm{
    lock
    faceplayer
    
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitmovement(0)

	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up * 3))
    waitmovement(0)
	delay (60)
    //call(NewBarkTown_EventScript_Elm_Speech)
    msgbox(format("Was I supposed to say something more inspiring?"))
    closemessage
	applymovement(LOCALID_NEWBARK_ELM, moves(face_up))
    waitmovement(0)
	opendoor(23, 12)
	waitdooranim
	applymovement(LOCALID_NEWBARK_ELM, moves(walk_up))
    waitmovement(0)
	closedoor(23, 12)
	waitdooranim
    removeobject(LOCALID_NEWBARK_ELM)
    setflag(FLAG_ADVENTURE_STARTED)

	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down * 3))
    waitmovement(0)
	special(RemoveCameraObject)
	delay(50)
    setvar(VAR_NEWBARK_TOWN_STATE, 1)
    reloadmap
    waitstate
    end
}

script NewBarkTown_EventScript_Aide{
    lock
    faceplayer
    setvar(VAR_STARTER_SOURCE, 1)
    msgbox(format("Aide: I'm Elm's Aide, he asked me to give all of you some items to help you on your journey, use them wisely!"))
    giveitem(ITEM_POKE_BALL, 5)
    giveitem(ITEM_POTION, 3)
    giveitem(ITEM_REPEL, 5)
    msgbox(format("You also need your Pokedex, this item lets you see all the data of Pokémon you see or catch."))
    setflag(FLAG_SYS_POKEDEX_GET)
	playfanfare(MUS_OBTAIN_ITEM)
	msgbox(format("{PLAYER} received the Pokédex!"), MSGBOX_DEFAULT)
	waitfanfare
    msgbox(format("And finally its time for you to choose your first partner Pokémon."))
    goto(NewBarkTown_EventScript_ChooseStarter)
}

script NewBarkTown_EventScript_ChooseStarter{
    msgbox(format("Choose the partner you want to have in your adventure."))
    //dynmultichoice(0, 0, TRUE, 6, 0, DYN_MULTICHOICE_CB_NONE, "Bulbasaur", "Charmander", "Squirtle", "Chikorita", "Cyndaquil", "Totodile", "Treecko" ,"Torchic", "Mudkip", "Turtwig", "Chimchar", "Piplup", "Snivy", "Tepig", "Oshawott", "Chespin", "Fennekin", "Froakie", "Rowlet", "Litten", "Popplio", "Grookey", "Scorbunny", "Sobble", "Sprigatito", "Fuecoco", "Quaxly", "Browt", "Pombon", "Gecqua", "Pikachu", "Eevee", "Riolu")
    dynmultichoice(0, 0, TRUE, 6, 0, DYN_MULTICHOICE_CB_NONE, "Bulbasaur", "Charmander", "Squirtle", "Chikorita", "Cyndaquil", "Totodile", "Treecko" ,"Torchic", "Mudkip", "Turtwig", "Chimchar", "Piplup", "Snivy", "Tepig", "Oshawott", "Chespin", "Fennekin", "Froakie", "Rowlet", "Litten", "Popplio", "Grookey", "Scorbunny", "Sobble", "Sprigatito", "Fuecoco", "Quaxly", "Pikachu", "Eevee", "Riolu")
    //Give Starter
	showmonpic(SPECIES_NONE, 10, 3)
	msgbox(format("Do you want the {STR_VAR_2} Pokémon {STR_VAR_1} as your first partner?"), MSGBOX_YESNO)
	hidemonpic
	if (var(VAR_RESULT) == NO){
		goto(NewBarkTown_EventScript_ChooseStarter)
	}
	givemon(SPECIES_NONE, 5, ITEM_ORAN_BERRY)
	playfanfare(MUS_OBTAIN_ITEM)
	msgbox(format("{PLAYER} received a {STR_VAR_1}!"), MSGBOX_DEFAULT)
	waitfanfare
    setflag(FLAG_SYS_POKEMON_GET)
    setvar(VAR_NEWBARK_TOWN_STATE, 2)
    goto(NewBarkTown_EventScript_ElmPokedex)
    release
}

script NewBarkTown_EventScript_ElmPokedex{
    msgbox(format("You can start your journey by going to Route 29 to the left of Newbark, there should be some trainers ready for a challenge there so prepare yourself!."))
    setflag(FLAG_SYS_POKEMON_GET)
    if(var(VAR_STARTER_SOURCE) == 1){ //Warp if you talked to the aide
        msgbox(format("Aide: Good luck with your journey!"))
        reloadmap
        waitstate
    }
    else{
        msgbox(format("Prof Elm: Good luck with your journey!"))
    }
    release
    end
}

script NewBarkTown_EventScript_Woman_Trigger_0{
    setvar(VAR_WOMAN_TRIGGER, 0)
    call(NewBarkTown_EventScript_Woman_Trigger_Base)
}

script NewBarkTown_EventScript_Woman_Trigger_1{
    setvar(VAR_WOMAN_TRIGGER, 1)
    call(NewBarkTown_EventScript_Woman_Trigger_Base)
}

script NewBarkTown_EventScript_Woman_Trigger_2{
    setvar(VAR_WOMAN_TRIGGER, 2)
    call(NewBarkTown_EventScript_Woman_Trigger_Base)
}

script NewBarkTown_EventScript_Woman_Trigger_Base{
    lock
    //applymovement(LOCALID_NEWBARK_WOMAN, moves(walk_in_place_faster_down))
    //waitmovement(0)

	playse(SE_PIN)
    applymovement(LOCALID_NEWBARK_WOMAN, Common_Movement_ExclamationMark)
    waitmovement(0)

    switch(var(VAR_WOMAN_TRIGGER)){
        case 1:
            applymovement(LOCALID_NEWBARK_WOMAN, moves(
                walk_down
            ))
            waitmovement(0)
        break
        case 2:
            applymovement(LOCALID_NEWBARK_WOMAN, moves(
                walk_down * 2
            ))
            waitmovement(0)
        break
    }
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitmovement(0)

    msgbox(format("Oh, {PLAYER}…! Prof.Elm is doing some kind of conference outside his laboratory, you should go to see what is happening!"))
    closemessage

    switch(var(VAR_WOMAN_TRIGGER)){
        case 1:
            applymovement(LOCALID_NEWBARK_WOMAN, moves(
                walk_up
                face_down
            ))
            waitmovement(0)
        break
        case 2:
            applymovement(LOCALID_NEWBARK_WOMAN, moves(
                walk_up * 2
                face_down
            ))
            waitmovement(0)
        break
    }

    applymovement(LOCALID_PLAYER, moves(walk_right))
    waitmovement(0)
    setvar(VAR_WOMAN_TRIGGER, 0) //Makes the script run again if you go here again
    release
}

script NewBarkTown_EventScript_Woman{
    lock
    faceplayer
    msgbox(format("Wild Pokémon appear after this area, be careful and visit the Pokémon Center when you need to heal your party!."))
    release
}

//Pokémon Lab
script NewBarkTown_EventScript_Elm_Starter{
    lock
    faceplayer
    if(flag(FLAG_SYS_POKEMON_GET)){
        msgbox(format("Prof Elm: Good luck with your journey!."))
    }
    else{
        setvar(VAR_STARTER_SOURCE, 0)
        msgbox(format("Prof Elm: I see you came to see me directly, I should give you some items to help you on your journey."))
        giveitem(ITEM_POKE_BALL, 5)
        giveitem(ITEM_POTION, 3)
        giveitem(ITEM_REPEL, 5)
        msgbox(format("You also need your Pokedex, this item lets you see all the data of Pokémon you see or catch"))
        setflag(FLAG_SYS_POKEDEX_GET)
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox(format("{PLAYER} received the Pokédex!"), MSGBOX_DEFAULT)
        waitfanfare
        msgbox(format("And finally its time for you to choose your first partner Pokémon."))
        goto(NewBarkTown_EventScript_ChooseStarter)
    }
}

