mapscripts Mt_Freeze_MapScripts {
	
}

const MT_FREEZE_TRAINER_1 = TRAINER_CALVIN_1
script Mt_Freeze_EventScript_Trainer_1{
	trainerbattle_single(MT_FREEZE_TRAINER_1, format("You picked a rough day to climb! Then again, every day's a rough day up here! Let's see if you can handle the cold!"), format("Brrr! That battle gave me chills! And not from the weather!"))
	msgbox(format("The snow never stops falling on Mt. Freeze. Better keep moving, or you'll freeze where you stand!"), MSGBOX_AUTOCLOSE)
	end
}

const MT_FREEZE_TRAINER_2 = TRAINER_CALVIN_1
script Mt_Freeze_EventScript_Trainer_2{
	trainerbattle_single(MT_FREEZE_TRAINER_2, format("I've climbed mountains all across the world! But this one? This one's something else! Let's see if your Pokémon are as tough as you think!"), format("Looks like I've still got a mountain to climb..."))
	msgbox(format("The higher you climb, the worse the weather gets. Grusha's waiting near the summit. I'd make sure your team's ready before going any farther!"), MSGBOX_AUTOCLOSE)
	end
}

const MT_FREEZE_TRAINER_3 = TRAINER_CALVIN_1
script Mt_Freeze_EventScript_Trainer_3{
	trainerbattle_single(MT_FREEZE_TRAINER_3, format("You made it this far? Not bad! But if you think I'm letting you reach Grusha without a fight, you're dreaming!"), format("Whoa! You completely wiped me out!"))
	msgbox(format("Grusha used to be a professional snowboarder, you know. He doesn't talk much about those days anymore. Just don't mistake his quiet attitude for weakness!"), MSGBOX_AUTOCLOSE)
	end
}

const TRAINER_GRUSHA = TRAINER_MAY_ROUTE_103_TORCHIC
script Mt_Freeze_EventScript_Grusha{
    faceplayer
    lock
    if(flag(FLAG_DEFEATED_GRUSHA)){
        msgbox(format("Still here? The path back down is open. You've got other challenges waiting for you. ...Don't keep them waiting."))
    }
    else{
        msgbox(format("You made it. Most Trainers turn back before reaching the summit. Guess you're more determined than you look. The tournament organizers picked this mountain for my challenge. Pretty convenient for an Ice-type specialist, don't you think? ...But don't expect me to go easy on you. The mountain doesn't care how prepared you are. And neither do I. Ready?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            msgbox(format("Let's see how long you last in the cold."))
            trainerbattle_no_intro(TRAINER_GRUSHA, format("...Huh. Guess I underestimated you."))
            msgbox(format("You handled yourself pretty well. Most Trainers panic when the weather turns against them. You didn't. ...That's worth something. Go on. You've earned the right to continue. Just remember... One wrong move can send everything crashing down. ...Before you go, take these"))
            giveitem(ITEM_HEX_ORB, 1)
            msgbox(format("hat TM contains Icy Wind. It damages your opponent while lowering their Speed. Useful for slowing down anything that gets too aggressive."))
            giveitem(ITEM_SHELL_BELL, 1)
            msgbox(format("here's a Shell Bell. It restores a little HP whenever your Pokémon deals damage. ...Nothing fancy, but knowing how to use what you've got can make all the difference. Anyway... Good luck out there."))
            setflag(FLAG_DEFEATED_GRUSHA)
        }
    }
    release
    end
}